# Soulmate Path Environment Configuration Example

ENVIRONMENT=development
DEBUG=false
APP_BASE_URL=http://localhost:3000
API_PREFIX=/api/soulmate

# CORS (comma-separated origins or JSON array)
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database connection
DATABASE_URL=postgresql://soulmate:soulmate_dev_password@localhost:5432/soulmate_dev

# Third-party integrations (SP-401, SP-601)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# OPENAI_API_KEY=
