# ==============================================================================
# Soulmate Path — Environment Configuration Example (DEV-SPEC §22, Decisions: DOMAIN-01, PAY-01)
# Copy this file to .env or .env.local for local development. Never commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Base URL (DOMAIN-01: No hardcoded domains; APP_BASE_URL is source of truth)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_BASE_URL=http://localhost:3000
API_PREFIX=/api/soulmate
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL 16)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://soulmate:soulmate_dev_password@localhost:5432/soulmate_dev
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ------------------------------------------------------------------------------
# 3. Soulmate Quiz & Business Timers (Spec §4, §10, Decisions: TIME-01)
# ------------------------------------------------------------------------------
SOULMATE_QUIZ_VERSION=soulmate-quiz-v1
SOULMATE_SKETCH_UNLOCK_HOURS=12
SOULMATE_REPORT_UNLOCK_HOURS=24
SOULMATE_SKETCH_GENERATION_MODE=on_demand
SOULMATE_REPORT_GENERATION_MODE=on_demand

# ------------------------------------------------------------------------------
# 4. PayPal Integration & Pricing (Spec §9, Decisions: PAY-01, PAY-02, PAY-AUTH-01)
# ------------------------------------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PRODUCT_ID=
PAYPAL_SOULMATE_INTRO_PLAN_ID=
PAYPAL_SOULMATE_STANDARD_PLAN_ID=

SOULMATE_CURRENCY=USD
# PAY-01: Never invent production prices. In production, these must be explicitly configured.
SOULMATE_INTRO_PRICE=19.00
SOULMATE_REGULAR_PRICE=29.00

# ------------------------------------------------------------------------------
# 5. AI Image Generation / Sketch (Spec §11, Decisions: ASSET-01, PROMPT-01)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
SOULMATE_IMAGE_MODEL=gpt-image-2
SOULMATE_IMAGE_SIZE=1024x1536
SOULMATE_IMAGE_QUALITY=medium
SOULMATE_IMAGE_FORMAT=webp
SOULMATE_SKETCH_PROMPT_VERSION=v1

# ------------------------------------------------------------------------------
# 6. Report Generation Feature Flag (Spec §13, Decisions: REPORT-01, REPORT-02)
# Production generation stays disabled until REPORT-01/02 are resolved.
# ------------------------------------------------------------------------------
SOULMATE_REPORT_PROVIDER=
SOULMATE_REPORT_MODEL=
SOULMATE_REPORT_PROMPT_VERSION=

# ------------------------------------------------------------------------------
# 7. Durable Object Storage / S3 / CDN (Spec §11.6, Decisions: ASSET-01)
# ------------------------------------------------------------------------------
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_URL_PREFIX=

# ------------------------------------------------------------------------------
# 8. Async Job / Worker Configuration (Spec §12)
# ------------------------------------------------------------------------------
REDIS_URL=
JOB_WORKER_CONCURRENCY=4
