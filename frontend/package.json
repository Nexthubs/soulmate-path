{
  "name": "soulmate-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "scripts": {
    "sync:quiz": "node -e \"const fs=require('fs'); fs.copyFileSync('../config/quiz/soulmate-quiz-v1.json', 'src/soulmate/quiz/soulmate-quiz-v1.json'); console.log('Synced quiz config from canonical root.');\"",
    "prebuild": "npm run sync:quiz",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:prod-config": "node scripts/check-prod-config.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
